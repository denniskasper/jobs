# Copy to .env, which is untracked. Only deploy/deploy.sh and deploy/dokploy-deploy.sh read these;
# the service itself takes DATA_DIR, DATA_REPO_URL and DATA_REPO_TOKEN from Dokploy's environment.
#
# Reaching DOKPLOY_URL needs the tailnet, so a deployment by hand runs from any machine on it.
DOKPLOY_URL=http://dokploy.example.ts.net:3000
DOKPLOY_COMPOSE_ID=
DOKPLOY_API_KEY=

# Only deploy/verify-not-public.sh reads these, and only when run by hand. CI takes them from
# repository secrets instead.
JOBS_HOSTNAME=jobs.example.com
SERVER_PUBLIC_IP=203.0.113.7
# SERVER_PUBLIC_IPV6=
