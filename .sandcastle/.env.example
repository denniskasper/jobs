# Read by Sandcastle when the runner in this folder starts.
# Copy to .env beside this file and fill in. This whole folder is ignored by git.

# Claude Code OAuth token: run `claude setup-token` on the host. Uses your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Fine-grained GitHub token: https://github.com/settings/personal-access-tokens/new
# Repository access: only this repository. Permissions: Issues read and write (Metadata read
# comes with it). Nothing else: the agent never pushes.
GH_TOKEN=
